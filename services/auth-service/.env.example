# Copy this file to .env for local development. Never commit .env.

HTTP_ADDR=0.0.0.0:8081
GRPC_ADDR=0.0.0.0:9081
DATABASE_URL=postgres://auth:auth@localhost:5432/auth
NATS_URL=nats://localhost:4222
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM='Drone Drop <no-reply@dronedrop.local>'
OTP_TTL_SECS=600
OTP_RESEND_SECS=30

APP_PUBLIC_URL=http://localhost:8086
ISSUER=http://localhost:8086/api/auth
UI_URL=http://localhost:8086
# The Alexa+ MCP resource on user-service.
MCP_RESOURCE_URL=http://localhost:8085/mcp
# Token audiences of the user and merchant APIs. Default: APP_PUBLIC_URL + /api/user and
# /api/merchant (through ui-gateway). Without the gateway, use the services' own ports:
# USER_API_URL=http://localhost:8085
# MERCHANT_API_URL=http://localhost:8083
EXTRA_ALLOWED_ORIGINS=http://localhost:8087

# Generate with: python3 scripts/generate-auth-key.py
AUTH_SIGNING_KEY_FILE=services/auth-service/auth-signing-key.pem

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8086
UI_WEB_REDIRECT_URIS=http://localhost:8086/auth/callback,http://localhost:8087/auth/callback
UI_NATIVE_REDIRECT_URIS=dronedrop://auth/callback

# Optional Alexa client settings.
ALEXA_CLIENT_SECRET=
ALEXA_REDIRECT_URIS=