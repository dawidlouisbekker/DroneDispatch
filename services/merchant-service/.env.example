# merchant-service settings for `cargo run -p merchant-service`. Copy this file
# to .env; never commit .env. Shared settings come from the repository root .env;
# values here take precedence over it.
#
# Direct local mode (no ui-gateway): the app calls this service on its own port,
# so API_PUBLIC_URL (the token audience, and auth-service's MERCHANT_API_URL) is
# that port, and CORS lets the Expo dev server call it. Through ui-gateway, use
# API_PUBLIC_URL=http://localhost:8086/api/merchant and leave CORS_ALLOWED_ORIGINS unset.

HTTP_ADDR=0.0.0.0:8083
DATABASE_URL=postgres://merchant:merchant@localhost:5432/merchant
NATS_URL=nats://localhost:4222
API_PUBLIC_URL=http://localhost:8083
AUTH_ISSUER=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8087
