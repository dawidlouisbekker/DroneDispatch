# dispatch-service settings for `cargo run -p dispatch-service`. Copy this file to
# .env; never commit .env. Shared settings come from the repository root .env; values
# here take precedence over it.

EDGE_ZONE=sea-north
HTTP_ADDR=0.0.0.0:8082
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch_sea_north
# The zone's NATS leaf node (Compose publishes sea-north's on 4223).
NATS_URL=nats://localhost:4223
