# catalog-read-service settings for `cargo run -p catalog-read-service`. Copy this
# file to .env; never commit .env. Shared settings come from the repository root .env;
# values here take precedence over it.

EDGE_ZONE=sea-north
HTTP_ADDR=0.0.0.0:8084
DATABASE_URL=postgres://catalog_read:catalog_read@localhost:5432/catalog_read_sea_north
# The zone's NATS leaf node (Compose publishes sea-north's on 4223).
NATS_URL=nats://localhost:4223
CORS_ALLOWED_ORIGINS=http://localhost:8087
