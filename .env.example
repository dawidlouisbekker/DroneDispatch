# Copy to .env. Shared settings: docker compose reads it for ${...} substitution,
# and every service reads it under `cargo run` (svc_common::load_env), after its
# own services/<svc>/.env, which takes precedence.

# Public URLs. For Alexa+, use the named cloudflared tunnel hostnames.
AUTH_ISSUER=http://localhost:8081
# user-service's public origin: the Alexa+ MCP server is at <USER_PUBLIC_URL>/mcp.
USER_PUBLIC_URL=http://localhost:8085
# Host headers accepted on user-service /mcp, comma-separated. Add the tunnel hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# External services: CLOUD_SETUP.md explains how to get each value.
# Not read by any service yet: planned for milestones 3-7.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AMAZON_LOCATION_MAPS_API_KEY=
STRIPE_SECRET_KEY=
# Signing secret for snapshot events (payments, saved cards) sent to /webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# Signing secret for thin events (Accounts v2 seller onboarding) sent to /webhooks/stripe/thin.
STRIPE_THIN_WEBHOOK_SECRET=

# AWS deployment only. Locally, Mailpit replaces SES.
# SES_FROM_ADDRESS=
