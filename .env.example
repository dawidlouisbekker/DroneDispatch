# Copy to .env; docker compose reads it for ${...} substitution.

# Public URLs. For Alexa+, use the named cloudflared tunnel hostnames.
AUTH_ISSUER=http://localhost:8081
DISPATCH_PUBLIC_URL=http://localhost:8082
# Host headers accepted on dispatch-service /mcp, comma-separated. Add the tunnel hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Not read by any service yet: planned for milestones 3-7.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AMAZON_LOCATION_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
