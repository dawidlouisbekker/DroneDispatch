    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.1",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8087",
    "android": "expo start --android --port 8087",
    "ios": "expo start --ios --port 8087",
    "web": "expo start --web --port 8087",
    "build:web": "expo export --platform web",
    "gen:api": "openapi-typescript ../../api/openapi/user.yaml -o src/api/generated/user.ts && openapi-typescript ../../api/openapi/merchant.yaml -o src/api/generated/merchant.ts && openapi-typescript ../../api/openapi/catalog.yaml -o src/api/generated/catalog.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
