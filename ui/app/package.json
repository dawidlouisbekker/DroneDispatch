{
  "name": "dronedrop-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@maplibre/maplibre-react-native": "11.3.10",
    "@simplewebauthn/browser": "14.0.0",
