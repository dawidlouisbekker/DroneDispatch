# Copy to .env (git-ignored). EXPO_PUBLIC_* values are compiled into the app
# bundle, so never put secrets here.

# Local direct mode: each service on its own port (auth 8081, merchant 8083,
# catalog-read 8084, user 8085), started with `cargo run -p <service>`. The user
# and merchant URLs must match those services' API_PUBLIC_URL and auth-service's
# USER_API_URL / MERCHANT_API_URL.
# For the full Compose gateway, set EXPO_PUBLIC_APP_URL=http://localhost:8086 and
# remove the other URLs (they default to /api/auth, /api/user, /api/merchant, /api/catalog).
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_AUTH_ISSUER=http://localhost:8081
EXPO_PUBLIC_USER_API_URL=http://localhost:8085
EXPO_PUBLIC_MERCHANT_API_URL=http://localhost:8083
EXPO_PUBLIC_CATALOG_API_URL=http://localhost:8084

# Amazon Location Maps (CLOUD_SETUP.md §2.3). The web key is restricted by
# referrer, the native key by Android package / iOS bundle id.
EXPO_PUBLIC_AWS_REGION=us-west-2
EXPO_PUBLIC_MAPS_KEY_WEB=
EXPO_PUBLIC_MAPS_KEY_NATIVE=
